// ================================================================
// Firebase Storage 보안 규칙
// Firebase 콘솔 > Storage > 규칙(Rules) 탭에 이 내용을 그대로
// 붙여넣고 "게시(Publish)" 버튼을 누르세요.
// ================================================================
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 실험 HTML 파일: 누구나 읽을 수 있고, 관리자만 업로드/삭제 가능
    match /experiments/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'phase@phase.com'
                   && request.resource.size < 20 * 1024 * 1024   // 파일당 20MB 제한
                   && request.resource.contentType.matches('text/html.*');
      allow delete: if request.auth != null
                    && request.auth.token.email == 'phase@phase.com';
    }
  }
}
