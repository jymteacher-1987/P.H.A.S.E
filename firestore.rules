// ================================================================
// Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을
// 그대로 붙여넣고 "게시(Publish)" 버튼을 누르세요.
//
// phase@phase.com 을 다른 관리자 이메일로 바꾸고 싶다면
// 아래 두 곳의 이메일 주소를 함께 바꿔주세요.
// ================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 실험 목록: 누구나 읽을 수 있고, 관리자만 쓰기 가능
    match /experiments/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'phase@phase.com';
    }

    // 방문자 카운터: 누구나 읽을 수 있고, "1씩 증가"하는 요청만 허용
    match /counters/{docId} {
      allow read: if true;

      // 최초 생성: count 값이 1로 시작하는 경우만 허용
      allow create: if request.resource.data.count == 1;

      // 기존 문서 갱신: 정확히 1씩 증가하는 경우만 허용 (임의 조작 방지)
      allow update: if request.resource.data.count == resource.data.count + 1;
    }
  }
}
